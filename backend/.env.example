# ---- Runtime ----
APP_ENV=local
APP_NAME="Team Timesheet"
LOG_LEVEL=INFO

# ---- Database / Cache ----
DATABASE_URL=postgresql+asyncpg://timesheet:timesheet@localhost:5432/timesheet
DATABASE_URL_SYNC=postgresql+psycopg://timesheet:timesheet@localhost:5432/timesheet
REDIS_URL=redis://localhost:6379/0

# ---- CORS / Frontend ----
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000

# ---- Sessions / Cookies ----
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
SESSION_COOKIE_NAME=tsid
SESSION_TTL_SECONDS=43200
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
# Production iframe deployment: set SESSION_COOKIE_SECURE=true and
# SESSION_COOKIE_SAMESITE=none.

# ---- Auth mode ----
# LOCAL_DEV_AUTH MUST be false in any non-local environment.
LOCAL_DEV_AUTH=true

# ---- IMS embedding ----
IMS_ALLOWED_EMBED_ORIGINS=
# Example production value: https://ims.example.com

# ---- IMS OIDC ----
IMS_OIDC_ENABLED=false
IMS_OIDC_ISSUER=https://ims.example.com
IMS_OIDC_CLIENT_ID=timesheet-app
IMS_OIDC_CLIENT_SECRET=
IMS_OIDC_REDIRECT_URI=http://localhost:8000/api/v1/auth/ims/callback
IMS_OIDC_SCOPES="openid email profile groups"
IMS_OIDC_GROUPS_CLAIM=groups
IMS_OIDC_ADMIN_GROUPS=timesheet-admins
IMS_OIDC_MANAGER_GROUPS=timesheet-managers
IMS_OIDC_MEMBER_GROUPS=timesheet-members
# Required for JIT provisioning when more than one organization exists.
# IMS_OIDC_ORG_ID=<existing-organization-uuid>
# Optional RP-initiated logout redirect. Must use FRONTEND_URL or an approved
# IMS_ALLOWED_EMBED_ORIGINS origin.
# IMS_OIDC_POST_LOGOUT_REDIRECT=https://timesheet.example.com/login
# Legacy OIDC_* variables remain supported for existing deployments.

# ---- Location ----
LOCATION_REQUIRED=false
LOCATION_RETENTION_DAYS=365
REVERSE_GEOCODE_ENABLED=false
REVERSE_GEOCODE_PROVIDER=

# ---- GitHub ----
GITHUB_AUTH_MODE=pat
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_INSTALLATION_ID=
GITHUB_PAT=
GITHUB_API_BASE=https://api.github.com
GITHUB_SYNC_INTERVAL_SECONDS=600

# ---- Rate limits (per window, keyed by scope) ----
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_API=600/minute
RATE_LIMIT_GITHUB_SYNC=30/minute
RATE_LIMIT_ADMIN_RESYNC=2/hour

# ---- Business rules ----
DEFAULT_WORKDAY_HOURS=8
VARIANCE_THRESHOLD_MINUTES=60
AUTO_LOGOUT_MINUTES=600